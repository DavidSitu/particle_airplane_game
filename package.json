{
  "name": "preston-vs-particles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "build": "vite build",
    "check": "npm run verify:assets && npm run typecheck && npm run lint && npm run check:boundaries && npm run test:run && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "eslint": "10.9.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
